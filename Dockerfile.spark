FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    SPARK_LOCAL_DIRS=/tmp/spark

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
RUN mkdir -p src/mobility_flow \
    && touch src/mobility_flow/__init__.py \
    && pip install --upgrade pip \
    && pip install ".[spark]"
COPY src ./src
RUN pip install --no-deps --force-reinstall .

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /tmp/spark \
    && chown -R appuser:appuser /tmp/spark
USER appuser

EXPOSE 8081 4040
CMD ["uvicorn", "mobility_flow.spark_runner:app", "--host", "0.0.0.0", "--port", "8081"]
