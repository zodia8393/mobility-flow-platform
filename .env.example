# Local-only credentials. Change them before any shared deployment.
POSTGRES_USER=mobility
POSTGRES_PASSWORD=mobility_local
MINIO_ROOT_USER=mobility_minio
MINIO_ROOT_PASSWORD=mobility_minio_local
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=local-only-change-me
OPS_TOKEN=local-ops-token

# Optional AWS mode. Leave S3_ENDPOINT_URL empty to use AWS S3.
AWS_REGION=ap-northeast-2
S3_BUCKET=mobility-lake
S3_ENDPOINT_URL=http://localhost:19000
